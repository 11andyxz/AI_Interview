# ====== Build Stage ======
FROM --platform=linux/amd64 node:20-alpine AS build
WORKDIR /app

# 拷贝 package.json 先安装依赖（利用 Docker 缓存）
COPY package.json package-lock.json ./
# 使用 npm install，避免对 lock 文件过于严格（允许轻微不一致）
RUN npm install --omit=dev

# 拷贝源代码
COPY public ./public
COPY src ./src
COPY tailwind.config.js ./

# 设置后端 API 地址（构建时注入，部署脚本会传入实际值）
ARG REACT_APP_API_BASE_URL=http://localhost:8080
ARG REACT_APP_WS_BASE_URL=http://localhost:8080
ENV REACT_APP_API_BASE_URL=${REACT_APP_API_BASE_URL}
ENV REACT_APP_WS_BASE_URL=${REACT_APP_WS_BASE_URL}

# 构建生产版本
RUN npm run build

# ====== Run Stage: Nginx 托管静态文件 ======
FROM --platform=linux/amd64 nginx:1.25-alpine

# 自定义 nginx 配置：SPA 路由 + API 代理
RUN rm /etc/nginx/conf.d/default.conf
COPY --from=build /app/build /usr/share/nginx/html

# 写入 nginx 配置
RUN cat > /etc/nginx/conf.d/default.conf << 'EOF'
server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # gzip 压缩
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml text/javascript image/svg+xml;

    # React SPA 路由：所有非文件请求都指向 index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 静态资源长缓存
    location /static/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # 健康检查
    location /healthz {
        return 200 'ok';
        add_header Content-Type text/plain;
    }
}
EOF

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
