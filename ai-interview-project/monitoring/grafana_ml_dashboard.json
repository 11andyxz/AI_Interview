{
  "dashboard": {
    "title": "ML Model Observability Dashboard",
    "tags": ["ml", "observability", "ai"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Request Overview",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(ai_request_count[5m]))",
            "legendFormat": "Request Rate (req/min)"
          },
          {
            "expr": "sum(rate(ai_request_count{status='success'}[5m])) / sum(rate(ai_request_count[5m]))",
            "legendFormat": "Success Rate"
          }
        ],
        "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}
      },
      {
        "id": 2,
        "title": "Latency Analysis",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(ai_request_latency_ms_bucket[5m]))",
            "legendFormat": "P50 Latency"
          },
          {
            "expr": "histogram_quantile(0.95, rate(ai_request_latency_ms_bucket[5m]))",
            "legendFormat": "P95 Latency"
          },
          {
            "expr": "histogram_quantile(0.99, rate(ai_request_latency_ms_bucket[5m]))",
            "legendFormat": "P99 Latency"
          }
        ],
        "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}
      },
      {
        "id": 3,
        "title": "Quality Metrics",
        "type": "stat",
        "targets": [
          {
            "expr": "avg(ai_validation_pass_rate)",
            "legendFormat": "Validation Pass Rate"
          },
          {
            "expr": "avg(ai_quality_score)",
            "legendFormat": "Quality Score"
          },
          {
            "expr": "sum(rate(ai_retry_count[5m]))",
            "legendFormat": "Retry Rate"
          }
        ],
        "gridPos": {"x": 0, "y": 8, "w": 8, "h": 6},
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 0.9, "color": "yellow"},
                {"value": 0.95, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "Cost & Usage",
        "type": "timeseries",
        "targets": [
          {
            "expr": "sum(rate(ai_token_usage[1h]))",
            "legendFormat": "Tokens per Hour"
          },
          {
            "expr": "sum(ai_cost_per_request) * sum(rate(ai_request_count[1h])) * 24",
            "legendFormat": "Estimated Daily Cost"
          }
        ],
        "gridPos": {"x": 8, "y": 8, "w": 8, "h": 6}
      },
      {
        "id": 5,
        "title": "Model Comparison (A/B Test)",
        "type": "table",
        "targets": [
          {
            "expr": "avg(ai_request_latency_ms) by (model_version)",
            "format": "table",
            "instant": true
          },
          {
            "expr": "avg(ai_quality_score) by (model_version)",
            "format": "table",
            "instant": true
          },
          {
            "expr": "avg(ai_cost_per_request) by (model_version)",
            "format": "table",
            "instant": true
          }
        ],
        "gridPos": {"x": 16, "y": 8, "w": 8, "h": 6}
      },
      {
        "id": 6,
        "title": "Drift Detection Status",
        "type": "gauge",
        "targets": [
          {
            "expr": "kl_divergence",
            "legendFormat": "KL Divergence"
          }
        ],
        "gridPos": {"x": 0, "y": 14, "w": 6, "h": 4},
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 0.1, "color": "yellow"},
                {"value": 0.15, "color": "red"}
              ]
            },
            "max": 0.3
          }
        }
      },
      {
        "id": 7,
        "title": "Recent Alerts",
        "type": "logs",
        "targets": [
          {
            "expr": "{metric_name='alert_triggered'}",
            "legendFormat": "Alert Log"
          }
        ],
        "gridPos": {"x": 6, "y": 14, "w": 18, "h": 6}
      }
    ],
    "refresh": "30s",
    "time": {
      "from": "now-24h",
      "to": "now"
    }
  }
}
