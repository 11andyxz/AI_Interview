# ====== Build Stage ======
FROM --platform=linux/amd64 maven:3.9.6-eclipse-temurin-17 AS build
WORKDIR /app

# 先拷贝 pom.xml 下载依赖（利用 Docker 缓存）
COPY pom.xml .
RUN mvn -q -e -B dependency:go-offline

# 拷贝源代码并打包（跳过测试）
COPY src ./src
RUN mvn -q -e -B clean package -Dmaven.test.skip=true

# ====== Run Stage ======
FROM --platform=linux/amd64 eclipse-temurin:17-jre
WORKDIR /app

# 创建上传目录
RUN mkdir -p /app/uploads/resumes /app/uploads/audio /app/logs

# 拷贝打好的 jar
COPY --from=build /app/target/backend-0.0.1-SNAPSHOT.jar app.jar

# Cloud Run 使用 PORT 环境变量
ENV PORT=8080
EXPOSE 8080

# 启动参数：激活 prod profile，优化 JVM 内存
ENTRYPOINT ["java", \
  "-Xmx512m", \
  "-Xms256m", \
  "-Djava.security.egd=file:/dev/./urandom", \
  "-jar", "/app/app.jar"]
